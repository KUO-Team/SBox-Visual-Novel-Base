// We store the player's name so we can use it later.
// The default value here is a string with the value of "Garry".
(set name "Garry")

(label beginning
    (dialogue "What's your name?")

    // Input allows us to display an input box.
    // It then takes the input and stores it in the provided variable.
    // In this case, we'll be storing it in "name".
    (input name)
    (after jump display)
)

(label display
    // We interpolate the variable "name" into the text.
    // This is done by using curly braces prefixed with $ around the variable name.
    (dialogue "So your name is ${name}, huh? Nice to meet you!")
	(after load "/Scripts/ExampleScript.vnscript")
)

(start beginning)