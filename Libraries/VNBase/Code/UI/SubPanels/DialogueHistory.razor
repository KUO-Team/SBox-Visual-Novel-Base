@using Sandbox

@namespace VNBase.UI

@inherits SubPanel

@if ( !Player.IsValid() )
{
    return;
}

@* ReSharper disable CSharpWarnings::CS8974 *@
<root>
    <div class="header">
        <label class="title">History</label>
    </div>

    <div class="history" @ref="_historyPanel">
        @foreach ( var entry in Player.DialogueHistory )
        {
            <DialogueHistoryEntry Entry="@entry" Hud="@Hud" Player="@Player" Settings="@Settings"></DialogueHistoryEntry>
        }
    </div>

    <div class="footer">
        <button icon="close" onclick="@ToggleVisibility">Close</button>
    </div>
</root>
