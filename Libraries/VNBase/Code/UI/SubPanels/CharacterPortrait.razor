@using Sandbox

@namespace VNBase.UI

@inherits SubPanel

@if ( !Player.IsValid() )
{
    return;
}

<root class="portrait @( Player.State.SpeakingCharacter == Character.Character ? "speaker" : "" )">
    <img src="@( $"{Character?.ActivePortraitPath}" )" alt="@( Character.Character.IsValid() ? $"{Character.Character.Name}'s" : "Character" ) portrait"/>
</root>
